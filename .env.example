# Django Core Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Development uses SQLite automatically if empty)
# In production on Render, set this to your PostgreSQL connection string:
DATABASE_URL=

# LiveKit WebRTC Configuration
# Sign up at https://livekit.io or host your own LiveKit server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Google Gemini Real-Time Voice Assistant
# Get an API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Puck

# Feature Switches
ENABLE_WEBRTC_VOICE=True

# Email Notification Settings (Contact Form & Hire Me inquiries)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=danieljohnbrittoaj@gmail.com
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL=danieljohnbrittoaj@gmail.com
CONTACT_RECIPIENT_EMAIL=danieljohnbrittoaj@gmail.com
